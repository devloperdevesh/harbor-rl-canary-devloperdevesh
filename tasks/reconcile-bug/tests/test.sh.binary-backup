#!/bin/bash
set -euo pipefail

mkdir -p /logs/verifier
python3 - <<'PY'
import csv
import json
import os
import subprocess
import sys
import tempfile

program = "/app/reconcile.py"
checks = []

def run_case(rows, expected, name):
    with tempfile.NamedTemporaryFile(
        mode="w", suffix=".csv", newline="", delete=False
    ) as f:
        writer = csv.writer(f)
        writer.writerow(["tx_id", "timestamp", "amount", "status"])
        writer.writerows(rows)
        path = f.name

    try:
        result = subprocess.run(
            [sys.executable, program, path],
            capture_output=True,
            text=True,
            timeout=10
        )
        assert result.returncode == 0, (
            f"{name}: non-zero exit: {result.stderr}"
        )
        data = json.loads(result.stdout)
        assert set(data) == {
            "total_valid_amount", "valid_count", "failed_count"
        }, f"{name}: incorrect output keys"
        assert data == expected, (
            f"{name}: expected {expected}, got {data}"
        )
        checks.append((name, True))
    except Exception as exc:
        checks.append((name, False))
        print(f"FAIL {name}: {exc}")
    finally:
        os.unlink(path)

# Check 1: positional CLI, valid and failed transactions.
run_case([
    ["a", "2026-01-01T10:00:00Z", "10.10", "SUCCESS"],
    ["b", "2026-01-01T11:00:00Z", "4.25", "FAILED"],
    ["c", "2026-01-01T12:00:00Z", "99.99", "PENDING"],
], {
    "total_valid_amount": 10.1,
    "valid_count": 1,
    "failed_count": 1
}, "cli_and_statuses")

# Check 2: decimal-safe arithmetic and ignored malformed rows.
run_case([
    ["a", "2026-01-02T10:00:00Z", "0.10", "SUCCESS"],
    ["b", "2026-01-02T11:00:00Z", "0.20", "SUCCESS"],
    ["c", "not-a-date", "500", "SUCCESS"],
    ["d", "2026-01-02T12:00:00Z", "not-money", "SUCCESS"],
], {
    "total_valid_amount": 0.3,
    "valid_count": 2,
    "failed_count": 0
}, "decimal_and_malformed_rows")

# Check 3: latest transaction must be selected by instant, not text order.
run_case([
    ["x", "2026-01-01T10:00:00+02:00", "100.00", "SUCCESS"],
    ["x", "2026-01-01T09:00:00Z", "7.00", "FAILED"],
], {
    "total_valid_amount": 0.0,
    "valid_count": 0,
    "failed_count": 1
}, "timezone_aware_deduplication")

passed = sum(1 for _, ok in checks if ok)
for name, ok in checks:
    print(("PASS " if ok else "FAIL ") + name)

print(f"Verifier checks: {passed}/{len(checks)}")

reward = 1.0 if passed == len(checks) else 0.0
with open("/logs/verifier/reward.txt", "w") as f:
    f.write(f"{reward:.1f}\n")

if reward != 1.0:
    sys.exit(1)
PY
